{
  "name": "h5ai",
  "version": "1.5.0",
  "description": "Modern HTTP web server index.",
  "homepage": "https://github.com/pad92/h5ai",
  "author": "pad92",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pad92/h5ai.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=9.8.1"
  },
  "scripts": {
    "lint": "npm run -s lint:js && npm run -s lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint 'src/**/*.less'",
    "test": "node scripts/run-tests.js",
    "build": "gulp release",
    "icons": "node scripts/generate-icons.js",
    "test:php": "make --no-print-directory test-php",
    "precommit": "npm run -s lint && npm run -s test",
    "test:coverage": "c8 --all --include=\"src/_h5ai/public/js/**/*.js\" --reporter=text-summary --reporter=json-summary --reporter=cobertura --reports-dir=coverage/js node scripts/run-tests.js"
  },
  "devDependencies": {
    "@babel/core": "8.0.10",
    "@babel/preset-env": "8.0.7",
    "@fontsource/ubuntu": "^5.2.8",
    "@fontsource/ubuntu-mono": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "babel-loader": "^10.0.0",
    "c8": "12.0.0",
    "del": "^9.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^10.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-footer": "^2.1.0",
    "gulp-include": "^2.4.1",
    "gulp-insert": "^0.5.0",
    "gulp-less": "^5.0.0",
    "gulp-pug": "^5.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-uglify": "^3.0.2",
    "gulp-zip": "^6.1.0",
    "jsdom": "30.1.3",
    "kjua": "0.10.0",
    "lolight": "1.4.1",
    "marked": "^18.1.2",
    "movi-player": "^0.4.1",
    "normalize.css": "8.0.1",
    "postcss-less": "^7.0.1",
    "scar": "2.3.4",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "webpack-stream": "^7.0.0"
  },
  "dependencies": {
    "exif-js": "^2.3.0"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
