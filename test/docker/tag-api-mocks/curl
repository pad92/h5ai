#!/bin/sh

set -eu

OUTPUT=
URL=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --output|-o) OUTPUT=$2; shift 2 ;;
        --header|-H) shift 2 ;;
        https://*) URL=$1; shift ;;
        *) shift ;;
    esac
done

case "$URL" in
    *repository/tags\?*) ;;
    *) echo "unexpected URL: $URL" >&2; exit 2 ;;
esac
page=${URL##*page=}
printf '%s\n' "page=$page" >> "$TAG_API_LOG"
if [ "${TAG_API_FAIL_PAGE:-}" = "$page" ]; then
    echo 'mock API failure' >&2
    exit 22
fi
printf 'page=%s\n' "$page" > "$OUTPUT"
